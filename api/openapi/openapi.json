{
  "openapi": "3.1.0",
  "info": {
    "title": "新猿译码 Gateway API",
    "version": "0.1.0",
    "description": "新猿译码一期 Gateway 的公开只读 API 契约。"
  },
  "servers": [
    {
      "url": "/",
      "description": "同源 Gateway"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "进程健康检查",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Gateway 进程健康",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "服务就绪检查",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Gateway 可以接收请求",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1": {
      "get": {
        "summary": "API 版本入口",
        "operationId": "getServiceInfo",
        "responses": {
          "200": {
            "description": "Gateway 服务信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "获取项目列表",
        "operationId": "listProjects",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "名称、简介、分类、标签和技术栈关键词。",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "updated",
                "downloads",
                "stars"
              ],
              "default": "updated"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "项目分页列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/projects/{slug}": {
      "get": {
        "summary": "获取项目详情",
        "operationId": "getProject",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "项目详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/projects/{slug}/documents": {
      "get": {
        "summary": "获取项目文档目录",
        "operationId": "listProjectDocuments",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "项目文档目录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/projects/{slug}/documents/{documentSlug}": {
      "get": {
        "summary": "获取项目文档正文",
        "operationId": "getProjectDocument",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "documentSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Markdown 文档正文、大纲和稳定内容块",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/projects/{slug}/documents/{documentSlug}/comments": {
      "get": {
        "summary": "获取文档评论",
        "operationId": "listDocumentComments",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "documentSlug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }
        ],
        "responses": {
          "200": {
            "description": "文档评论列表",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommentListResponse" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "summary": "发布文档评论",
        "operationId": "createDocumentComment",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "documentSlug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCommentRequest" } } }
        },
        "responses": {
          "201": {
            "description": "评论已发布",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommentResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": {
            "description": "评论字段或稳定块锚点无效",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/v1/projects/{slug}/documents/{documentSlug}/comments/{commentID}": {
      "patch": {
        "summary": "解决文档评论",
        "operationId": "resolveDocumentComment",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "documentSlug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "commentID", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCommentRequest" } } }
        },
        "responses": {
          "200": {
            "description": "评论已解决",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommentResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "查询参数无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "service",
          "status"
        ],
        "properties": {
          "service": {
            "type": "string",
            "const": "gateway"
          },
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "ServiceInfoResponse": {
        "type": "object",
        "required": [
          "service",
          "api_version",
          "status"
        ],
        "properties": {
          "service": {
            "type": "string",
            "const": "gateway"
          },
          "api_version": {
            "type": "string",
            "const": "v1"
          },
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "ProjectMetrics": {
        "type": "object",
        "required": [
          "downloads",
          "stars",
          "comments"
        ],
        "properties": {
          "downloads": {
            "type": "integer",
            "minimum": 0
          },
          "stars": {
            "type": "integer",
            "minimum": 0
          },
          "comments": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProjectSummary": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "summary",
          "category",
          "tags",
          "stack",
          "license",
          "status",
          "maintainer",
          "updated_at",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "maintainer": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "metrics": {
            "$ref": "#/components/schemas/ProjectMetrics"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "page_size",
          "total",
          "total_pages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ProjectListResponse": {
        "type": "object",
        "required": [
          "data",
          "pagination",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ProjectDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProjectSummary"
          },
          {
            "type": "object",
            "required": [
              "description",
              "highlights",
              "use_cases",
              "repository",
              "current_version"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "highlights": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "use_cases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "repository": {
                "type": "string",
                "format": "uri"
              },
              "current_version": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ProjectDetailResponse": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProjectDetail"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "DocumentNode": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "order",
          "children"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentNode"
            }
          }
        }
      },
      "DocumentListResponse": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentNode"
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "DocumentOutlineItem": {
        "type": "object",
        "required": [
          "id",
          "title",
          "level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        }
      },
      "DocumentBlock": {
        "type": "object",
        "required": [
          "id",
          "type",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "DocumentDetail": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "slug",
          "title",
          "version",
          "updated_at",
          "markdown",
          "outline",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "markdown": {
            "type": "string"
          },
          "outline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentOutlineItem"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentBlock"
            }
          }
        }
      },
      "DocumentDetailResponse": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/DocumentDetail"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "DocumentComment": {
        "type": "object",
        "required": ["id", "document_id", "block_id", "author", "quote", "body", "status", "created_at", "resolved_at"],
        "properties": {
          "id": { "type": "string" },
          "document_id": { "type": "string" },
          "block_id": { "type": "string" },
          "author": { "type": "string" },
          "quote": { "type": "string" },
          "body": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "created_at": { "type": "string", "format": "date-time" },
          "resolved_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "CommentListResponse": {
        "type": "object",
        "required": ["data", "request_id"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/DocumentComment" } },
          "request_id": { "type": "string" }
        }
      },
      "CommentResponse": {
        "type": "object",
        "required": ["data", "request_id"],
        "properties": {
          "data": { "$ref": "#/components/schemas/DocumentComment" },
          "request_id": { "type": "string" }
        }
      },
      "CreateCommentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "author", "body"],
        "properties": {
          "block_id": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1, "maxLength": 80 },
          "quote": { "type": "string", "maxLength": 500 },
          "body": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      },
      "UpdateCommentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["resolved"] }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
