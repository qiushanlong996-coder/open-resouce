[Unit]
Description=Open Resouce Gateway
After=network.target

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/opt/open-resouce/current
Environment=HOST=127.0.0.1
Environment=PORT=18080
EnvironmentFile=-/etc/open-resouce/gateway.env
ExecStart=/opt/open-resouce/current/bin/gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
