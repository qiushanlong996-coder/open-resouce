# Copy to /etc/open-resouce/gateway.env and restrict it to the service owner.
# Percent-encode reserved URL characters in the username or password.
DATABASE_URL=mysql://open_resouce_app:replace-with-a-strong-secret@www.lovenuaa.xyz:3306/open_resouce
REDIS_URL=redis://:replace-with-the-redis-password@www.lovenuaa.xyz:6379/0
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-the-mailbox
SMTP_PASSWORD=replace-with-the-mailbox-authorization-code
SMTP_FROM=replace-with-the-sender-address
OSS_REGION=cn-guangzhou
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=replace-with-the-bucket
OSS_ACCESS_KEY_ID=replace-with-the-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-the-access-key-secret
CORS_ALLOWED_ORIGINS=https://www.openresource.cn
PUBLIC_BASE_URL=https://www.openresource.cn
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=

# AI 项目助手（Anthropic Messages API）。仅当 ANTHROPIC_API_KEY 非空时启用助手接口；
# 未配置时 /api/v1/projects/{slug}/assistant 返回 503 assistant_unavailable（不影响其他功能）。
# ANTHROPIC_BASE_URL 默认 https://api.anthropic.com，ANTHROPIC_MODEL 默认 claude-sonnet-5。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5

# 评论/用户列表的 IP 归属地（ip2region xdb 数据文件，不入库）。
# 文件来自 https://github.com/lionsoul2014/ip2region/tree/master/data
# （ip2region_v4.xdb / ip2region_v6.xdb）；只配 v4 也能工作，
# 两个都不配时归属地功能静默降级，不影响登录与评论。
IP_REGION_V4_DB_PATH=/var/lib/open-resouce/ip2region_v4.xdb
IP_REGION_V6_DB_PATH=/var/lib/open-resouce/ip2region_v6.xdb

# 集成测试专用数据库。库名必须以 _test 结尾，否则测试会拒绝运行。
# 该账号只对测试库授权，物理上无法写入生产库。不要复用应用账号。
# MYSQL_TEST_DATABASE_URL=mysql://open_resouce_test:replace-with-a-test-only-secret@www.lovenuaa.xyz:3306/open_resouce_test
